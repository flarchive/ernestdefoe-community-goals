{
    "name": "ernestdefoe/community-goals",
    "description": "Community Goals: the whole forum works together toward a shared target. Replies, new discussions, likes, new members or posts in a tag, with a big progress bar, milestone celebrations, top contributors, notifications and optional rewards when the goal is hit.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "goals",
        "community",
        "engagement",
        "progress",
        "challenge"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/community-goals",
    "support": {
        "issues": "https://github.com/ernestdefoe/community-goals/issues",
        "source": "https://github.com/ernestdefoe/community-goals"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\CommunityGoals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\CommunityGoals\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Community Goals",
            "category": "feature",
            "icon": {
                "name": "fas fa-flag-checkered",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/likes",
                "flarum/tags",
                "flarum/approval",
                "fof/badges",
                "fof/merge-discussions",
                "ernestdefoe/wardrobe",
                "ernestdefoe/festoon"
            ]
        }
    },
    "require-dev": {
        "flarum/approval": "^2.0",
        "flarum/gdpr": "^2.0",
        "flarum/likes": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
